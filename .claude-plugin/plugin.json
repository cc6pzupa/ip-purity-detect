{
  "name": "ip-purity",
  "version": "1.2.0",
  "description": "一键 IP 纯净度检测：多源免费 IP 库汇总，判断住宅/机房、代理/VPN（命中进负面清单直接 0 分）、风险分、人机流量比、黑名单、原生/广播；支持批量。含 skill 和 MCP。",
  "author": {
    "name": "cc6pzupa"
  },
  "repository": "https://github.com/cc6pzupa/ip-purity-detect",
  "keywords": [
    "ip",
    "proxy",
    "vpn",
    "residential",
    "ip-quality",
    "risk"
  ],
  "mcpServers": {
    "ip-purity": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.py"
      ]
    }
  },
  "network": {
    "hosts": [
      "ip-api.com",
      "api.ipapi.is",
      "proxycheck.io",
      "ipinfo.io",
      "ipwho.is",
      "api.ip.sb",
      "scamalytics.com",
      "api.ipify.org",
      "api64.ipify.org",
      "api6.ipify.org",
      "ifconfig.me",
      "icanhazip.com",
      "ipqualityscore.com",
      "api.abuseipdb.com",
      "api.ipquery.io",
      "www.iplocate.io",
      "api.ip2location.io",
      "blackbox.ipinfo.app",
      "check.torproject.org",
      "api.greynoise.io",
      "api.stopforumspam.org",
      "internetdb.shodan.io",
      "my.ippure.com",
      "api.cloudflare.com"
    ]
  }
}
